# このファイルをコピーして .env.local を作成してください（.env.local はコミットされません）
#   cp .env.example .env.local

# Google Cloud サービスアカウント JSON のパス（絶対パス推奨）
# Vertex AI 上の Gemini を Application Default Credentials で呼ぶために使います
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI (Gemini)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-2.5-flash

# SAFi を待ち受けるポート（オプション、デフォルト: 3000）
# PORT=3000

# 通話履歴の保持日数（オプション、デフォルト: 90）
# Firestore の TTL ポリシーが expiresAt を見て自動削除します
# HISTORY_RETENTION_DAYS=90

# 設定すると GET /api/history に X-SAFi-Api-Key ヘッダーの一致を要求します（オプション）
# 未設定だと userId を知っている人は誰でも通話の要約を読めます
# HISTORY_API_KEY=

# 待ち受けアドレス（オプション、デフォルト: 127.0.0.1）
# 既定ではこの端末からのみアクセスできます。認証もレート制限の上限も
# デモ想定の値なので、外部公開するなら認証を足してから変更してください。
# HOST=0.0.0.0
